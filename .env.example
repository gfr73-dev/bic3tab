# Copy this file to .env and fill in the real values.
DATABASE_URL=mysql://root:@localhost/bic3tab
FLASK_SECRET_KEY=replace-with-a-long-random-secret
AS400_DSN=cli000
AS400_UID=mobile
AS400_PWD=replace-with-the-IBM-i-password
AS400_TABLE=OPERACOES.BIC3TAB

# Keep localhost if users open the app on this server only.
# Set to 0.0.0.0 only when other computers must reach it; allow the port in Windows Firewall.
BIC3TAB_HOST=127.0.0.1
BIC3TAB_PORT=5800
WAITRESS_THREADS=8
